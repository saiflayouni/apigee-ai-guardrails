<?xml version="1.0" encoding="UTF-8"?>
<RaiseFault name="RF-ContentBlocked">
    <DisplayName>Raise Fault - Content Blocked</DisplayName>
    <FaultResponse>
        <Set>
            <StatusCode>403</StatusCode>
            <ReasonPhrase>Forbidden</ReasonPhrase>
            <Payload contentType="application/json">{"error": "content blocked by Model Armor", "direction": "%armor.direction%"}</Payload>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
