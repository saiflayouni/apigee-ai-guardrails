# Flask application: agent/app.py
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=projects/your-project-id/locations/us-central1/templates/your-template
TOOLBOX_SERVER=https://your-toolbox-service.example.com
TOOLBOX_TOOLSET=supply_chain_toolset
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Local development only. In Cloud Run inject this from Secret Manager.
GOOGLE_API_KEY=replace-locally
ENABLE_DEMO_FIXTURE=false
PORT=8080
# DB_PASSWORD is configured on the separate Toolbox service, not this app.
